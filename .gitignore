# CivicFix – Root .gitignore

# Environment variables & secrets
.env
*.env
!.env.example

# Python virtual environment & cache
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Node.js & Next.js
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/

# Database files
*.db
*.sqlite
*.sqlite3
test.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & Editor
.DS_Store
.vscode/
.idea/
*.swp
*.swo
uploads/
backend/uploads/

