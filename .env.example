# CivicFix – Environment Variable Template
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets.
# All values with :?  in compose.yml are REQUIRED before running the stack.

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=civicfix
POSTGRES_USER=civicfix
# REQUIRED: Choose a strong password.
POSTGRES_PASSWORD=change_me_strong_password_here

# ─── Backend / FastAPI ───────────────────────────────────────────────────────
# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PROJECT_NAME=CivicFix
DEBUG=false

# Comma-separated list of origins allowed to call the API (no trailing slash).
# In production, replace with your actual frontend URL(s).
BACKEND_CORS_ORIGINS=http://localhost:3000

# ─── Frontend / Next.js ──────────────────────────────────────────────────────
# This is baked into the browser JS bundle at build time.
# In production, set to the public base URL of your backend API.
# Example: https://api.civicfix.example.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ─── Ports (optional – override defaults) ────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ─── AI / OpenAI (optional) ──────────────────────────────────────────────────
# Leave empty to use mock AI provider (no real calls).
# Only set if you have a valid OpenAI API key.
OPENAI_API_KEY=
