# Root .dockerignore for Docker Compose builds
# Prevents large or secret files from being sent to the build context

# Version control
.git
.gitignore

# Python virtualenv and caches
.venv
**/__pycache__
**/*.pyc
**/*.pyo
.pytest_cache
*.egg-info

# Test DB and local state
test.db
*.db

# Frontend build artifacts and deps (frontend has its own stage copy)
frontend/node_modules
frontend/.next

# Local env files with real secrets
.env

# OS cruft
.DS_Store
Thumbs.db

# Editor
.idea
.vscode
*.swp
